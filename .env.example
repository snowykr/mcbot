# Discord Bot Token (필수)
# Discord Developer Portal에서 발급받은 봇 토큰
DISCORD_TOKEN=your_discord_bot_token_here

# 마인크래프트 서버 컨테이너 이름 (선택, 기본값: mc-server)
# MC_CONTAINER_NAME=mc-server

# 마크봇 사용 권한 역할 이름 (선택, 기본값: 마크봇)
# MCBOT_ROLE_NAME=마크봇

# 서버 시작 타임아웃 (초) (선택, 기본값: 600)
# READY_TIMEOUT_SECONDS=600

# 서버 종료 타임아웃 (초) (선택, 기본값: 120)
# STOP_TIMEOUT_SECONDS=120

# 서버 작업(시작/종료) 전체 타임아웃 (초) (선택, 기본값: 720)
# READY_TIMEOUT_SECONDS보다 같거나 크게 설정하는 것을 권장합니다
# SERVER_OPERATION_TIMEOUT_SECONDS=720

# 상시 임베드 메시지를 표시할 채널 ID (필수)
# Discord에서 채널을 우클릭 > ID 복사로 확인 가능
EMBED_CHANNEL_ID=your_channel_id_here

# 플레이어 접속 로그 패턴 (선택, 기본값: ]: (.+) joined the game)
# MC_JOIN_LOG_PATTERN=]: (.+) joined the game

# 플레이어 퇴장 로그 패턴 (선택, 기본값: ]: (.+) left the game)
# MC_LEAVE_LOG_PATTERN=]: (.+) left the game

# 임베드 업데이트 타임아웃 (초) (선택, 기본값: 10)
# EMBED_UPDATE_TIMEOUT_SECONDS=10

# 자동 복구 활성화 여부 (선택, 기본값: true)
# 허용 값: true, 1, yes, on / false, 0, no, off
# 인식할 수 없는 값은 경고 로그 출력 후 기본값 적용
# AUTO_RECOVER_ENABLED=true

# 자동 복구 시도 간격 (초) (선택, 기본값: 30)
# AUTO_RECOVER_INTERVAL_SECONDS=30

# 최대 자동 복구 시도 횟수 (선택, 기본값: 3)
# 0으로 설정하면 무제한 시도
# MAX_AUTO_RECOVER_ATTEMPTS=3

# 크래시 감지 주기 (초) (선택, 기본값: 2)
# CRASH_DETECTION_INTERVAL_SECONDS=2

# 컨테이너 상태 확인 연속 실패 허용 횟수 (선택, 기본값: 3)
# 최소 1 이상이어야 함 (첫 실패에서 바로 크래시 처리하려면 1로 설정)
# MAX_INSPECT_FAILURE_ATTEMPTS=3

# ===== RCON 설정 (선택적) =====
# RCON_PASSWORD를 설정하면 Discord에서 /마크봇 rcon 명령어를 사용할 수 있습니다.
# docker-compose.yml은 이 값이 설정된 경우에만 mc-server 컨테이너에 문자열 값으로 반영합니다.
# RCON_PASSWORD를 비워 두지 말고, 사용하지 않을 때는 .env에서 해당 줄 자체를 제거하세요.
# 미설정 시에도 mc-server의 RCON_CMDS_STARTUP 등 내부 RCON 기능은 정상 작동합니다.
# (itzg/minecraft-server는 RCON_PASSWORD가 컨테이너에 전달되지 않으면 랜덤 비밀번호를 자동 생성)

# RCON 비밀번호 (설정 시 Discord RCON 명령어 활성화)
# RCON_PASSWORD=your_rcon_password_here

# RCON 서버 호스트 (선택, 기본값: mc-server)
# RCON_HOST=mc-server

# RCON 서버 포트 (선택, 기본값: 25575)
# RCON_PORT=25575

# RCON 명령 타임아웃 (초) (선택, 기본값: 10)
# RCON_TIMEOUT_SECONDS=10
